<?xml version="1.0" encoding="utf-8"?>
<!--
  BDF MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build bdf.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... [-d ModelsDir=...] -d IconPath=... -o out.msi
    (ModelsDir is optional: without it the MSI has no OCR models, which is the v1 core package)

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional, and an update keeps it only if it is still there), an App Paths entry, BDF registered as a PDF handler (offered under "Open with"
  and in Default apps, never forced as the default), and "Edit with BDF" on PDF files'
  right-click menu (on by default, optional). Files opened with BDF arrive on its command
  line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="BDF"
      Manufacturer="BDF project"
      Version="$(var.Version)"
      UpgradeCode="0F334A01-A3CE-43E4-8E43-21EA4C6DCD17"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="BDF PDF workbench" Manufacturer="BDF project" />
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="BDF must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of BDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="BdfIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="BdfIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/btecme/bdf" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/btecme/bdf" />
    <Property Id="ARPHELPLINK" Value="https://github.com/btecme/bdf/issues" />
    <!-- Desktop shortcut (#143): on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop (#1058): the launcher
         updates with /passive and no properties, so deleting the shortcut is the only way its
         users can say no. A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="BDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- "Edit with BDF" on the right-click menu of PDF files in File Explorer (#682): on by
         default, the same way, and INSTALLPDFCONTEXTMENU=0 for unattended installs without it. -->
    <Property Id="INSTALLPDFCONTEXTMENU" Value="1" Secure="yes" />
    <UIRef Id="BdfInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="BDF">
        <?ifdef ModelsDir ?>
        <Directory Id="ModelsFolder" Name="models" />
        <?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="BDF" Level="1">
      <ComponentGroupRef Id="BdfFiles" />
      <?ifdef ModelsDir ?>
      <ComponentGroupRef Id="BdfModels" />
      <?endif?>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="BdfFiles" Directory="INSTALLFOLDER">
      <Component Id="BdfApp" Guid="433ADD8B-5CD0-4AE3-9074-72DB90D7553D">
        <File Id="BdfExe" Source="$(var.BinDir)\bdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\bdf.exe" Value="[#BdfExe]" Type="string" />

        <!-- PDF files (#107): BDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             BDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\BDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app icon; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\BDF.Document\DefaultIcon" Value="&quot;[#BdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\BDF.Document\shell\open\command" Value="&quot;[#BdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="BDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\bdf.exe" Name="FriendlyAppName" Value="BDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\bdf.exe\DefaultIcon" Value="&quot;[#BdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\bdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\bdf.exe\shell\open\command" Value="&quot;[#BdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\BDF\Capabilities" Name="ApplicationName" Value="BDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\BDF\Capabilities" Name="ApplicationDescription" Value="Open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\BDF\Capabilities" Name="ApplicationIcon" Value="[#BdfExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\BDF\Capabilities\FileAssociations" Name=".pdf" Value="BDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="BDF" Value="Software\BDF\Capabilities" Type="string" />

        <!-- Image context menu (#190): convert without changing image file defaults. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BDF.CreatePdf" Value="Create PDF with BDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\BDF.CreatePdf\command" Value="&quot;[#BdfExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to bdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="BdfStartMenuShortcut" Directory="ProgramMenuFolder" Guid="E0F845DB-0720-427B-8B8A-15E169F5F150">
        <Shortcut Id="StartMenuShortcut" Name="BDF" Description="BDF PDF workbench"
            Target="[#BdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="BdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\BDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="BdfDesktopShortcut" Directory="DesktopFolder" Guid="A93DB793-3875-491D-A148-76E9750B50D9"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="BDF" Description="BDF PDF workbench"
            Target="[#BdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="BdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\BDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with BDF" opens the file in BDF whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="BdfPdfContextMenu" Guid="23BE3445-29E3-47ED-861E-892C2F29F8EC"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BDF.Edit" Value="Edit with BDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BDF.Edit" Name="Icon" Value="&quot;[#BdfExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BDF.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\BDF.Edit\command" Value="&quot;[#BdfExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="BdfCli">
        <File Id="BdfCliExe" Source="$(var.BinDir)\bdf-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The private document-processing process the app and the CLI start; never run by hand. -->
      <Component Id="BdfWorker">
        <File Id="BdfWorkerExe" Source="$(var.BinDir)\bdf-worker.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="BdfDocumentIconLicense">
        <File Id="BdfDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="BdfMitLicense">
        <File Id="BdfMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="BdfApacheLicense">
        <File Id="BdfApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="BdfNotice">
        <File Id="BdfNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside bdf.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. Only when ModelsDir is defined:
         the v1 core package has none (OCR is deferred). -->
    <?ifdef ModelsDir ?>
    <ComponentGroup Id="BdfModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
    <?endif?>
  </Fragment>
</Wix>
